<% content_for :title, 'Testimonials' %>
<div class="wrapper image-wrapper bg-image inverse-text" data-image-src="<%= asset_path('bg4.jpg') %>">
  <div class="container inner pt-120 pb-120 text-center">
    <h1 class="heading mb-0">Testimonials</h1>
  </div>
</div>
<section class="testimonials-section">
  <h2>What Our Clients Says</h2>
  <div class="testimonials-grid">
    <% @testimonials.each do |testimonial| %>
      <div class="testimonial-card">
        <% if testimonial.photo.present? %>
          <%= image_tag testimonial.photo.image.url(:thumb), class: "avatar-img", alt: testimonial.client_name %>
        <% end %>
        <p class="testimonial-quote"><%= testimonial.message %></p>
        <div class="testimonial-footer">
          <span class="testimonial-name"><%= testimonial.client_name %></span>
          <div class="stars">
            <% (1..5).each do |i| %>
              <% if i <= testimonial.rating.to_i %>
                <!-- Filled star -->
                <svg class="star filled" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.966a1 1 0 00.95.69h4.175c.969 0 1.371 1.24.588 1.81l-3.38 2.455a1 1 0 00-.364 1.118l1.287 3.966c.3.921-.755 1.688-1.54 1.118l-3.38-2.455a1 1 0 00-1.175 0l-3.38 2.455c-.784.57-1.838-.197-1.539-1.118l1.286-3.966a1 1 0 00-.364-1.118L2.05 9.393c-.783-.57-.38-1.81.588-1.81h4.175a1 1 0 00.95-.69l1.286-3.966z"/>
                </svg>
              <% else %>
                <!-- Empty star -->
                <svg class="star empty" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.966a1 1 0 00.95.69h4.175c.969 0 1.371 1.24.588 1.81l-3.38 2.455a1 1 0 00-.364 1.118l1.287 3.966c.3.921-.755 1.688-1.54 1.118l-3.38-2.455a1 1 0 00-1.175 0l-3.38 2.455c-.784.57-1.838-.197-1.539-1.118l1.286-3.966a1 1 0 00-.364-1.118L2.05 9.393c-.783-.57-.38-1.81.588-1.81h4.175a1 1 0 00.95-.69l1.286-3.966z"/>
                </svg>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</section>

<style>
  .testimonials-section {
    background: #f9fafb;
    padding: 3rem 1rem;
  }

  .testimonials-section h2 {
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 2rem;
    color: #111827;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .testimonial-card {
     background: #fff;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 6px 18px rgba(0,0,0,0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .testimonial-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
  }

  .testimonial-card img {
    border-radius: 50%;
    width: 80px;
    height: 80px;
    object-fit: cover;
    border: 3px solid #fbbf24; /* gold border around photo */
    margin-bottom: 1rem;
  }

  .testimonial-quote {
    font-style: italic;
    color: #444;
    position: relative;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .testimonial-quote::before {
    content: "“";
    font-size: 2rem;
    color: #fbbf24;
    position: absolute;
    left: -15px;
    top: -10px;
  }

  .testimonial-quote::after {
    content: "”";
    font-size: 2rem;
    color: #fbbf24;
    position: absolute;
    right: -15px;
    bottom: -10px;
  }


  .testimonial-photo {
    width: 100%;
    height: 220px;
    object-fit: cover;
  }

  .testimonial-body {
    padding: 1rem 1.25rem;
  }

  .testimonial-content {
    font-size: 0.95rem;
    font-style: italic;
    color: #374151;
    margin-bottom: 1rem;
  }

  .testimonial-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
  }

  .testimonial-name {
    font-weight: bold;
    font-size: 1.1rem;
    color: #222;
    display: inline-block;   /* ensure it doesn’t force stars below */
    margin: 0;
  }

  .stars {
    display: flex;
    gap: 3px;
  }

  .star {
    width: 20px;
    height: 20px;
  }

  .star.filled {
    color: #fbbf24; /* yellow */
  }

  .star.empty {
    color: #d1d5db; /* light gray */
  }

  /* Responsive grid */
  @media (min-width: 768px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .testimonials-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>