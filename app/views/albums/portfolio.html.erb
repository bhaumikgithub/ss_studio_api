<% content_for :title, 'Portfolio' %>
<div class="wrapper image-wrapper bg-image inverse-text" data-image-src="<%= asset_path('bg13.jpg') %>">
  <div class="container inner pt-120 pb-120 text-center">
    <h1 class="heading">OUR AWESOME WORK</h1>
  </div>
</div>
<div class="wrapper light-wrapper">
  <div class="container inner">
    <div class="mb-4">
      <%= select_tag :main_category, options_for_select([["Wedding", "wedding"], ["Kids", "kids"], ["Corporate", "corporate"]]), prompt: "Select Main Category", class: "form-control d-inline-block w-auto", id: "main-category-dropdown", data: { remote: true, url: portfolio_path(user: params[:user].sub(/^\/sites\/sagargadani/, '')) } %>
    </div>
    <div id="cube-grid-large-filter" class="cbp-filter-container text-center">
      <div class="cbp-filter-item-active cbp-filter-item">
        <% unless params[:main_category].present? %>
          <%= link_to "All", change_portfolio_url(portfolio_path(user: params[:user], category: "all"), '/portfolio'), class: "normal-links", remote: true %>
        <% end %>
      </div>
      <%= @categories.each do |category| %>
        <div class="cbp-filter-item"><%= link_to category.category_name, change_portfolio_url(portfolio_path(user: params[:user], category: category.category_name), '/portfolio'), class: "normal-links", remote: true %></div>
      <% end %>
    </div>
    <div class="clearfix"></div>
    <div class="space20"></div>
    <div id="slide-portfolio">
      <%= render partial: 'portfolio', locals: {categories: @categories, portfolio_albums: @portfolio_albums}, remote: true %>
    </div>
  </div>
</div>

<script>
  document.addEventListener("turbolinks:load", function() {
    const dropdown = document.getElementById("main-category-dropdown");
    if (dropdown) {
      dropdown.addEventListener("change", function() {
        let url = dropdown.dataset.url;
        const value = dropdown.value;

        url = url.replace(/(\/sites\/sagargadani){2,}/, '/sites/sagargadani');

        fetch(`${url}?main_category=${encodeURIComponent(value)}`, {
          headers: { "X-Requested-With": "XMLHttpRequest" }
        })
          .then(response => response.text())
          .then(html => {
            document.getElementById("cube-grid-large-filter").innerHTML =
              new DOMParser().parseFromString(html, "text/html")
                .getElementById("cube-grid-large-filter").innerHTML;

            document.getElementById("slide-portfolio").innerHTML =
              new DOMParser().parseFromString(html, "text/html")
                .getElementById("slide-portfolio").innerHTML;
          });
      });
    }
  });
</script>

<style>
  #main-category-dropdown{
    width: 20%;
  }
</style>