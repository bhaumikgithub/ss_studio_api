<% if @user_color.present? %>
  <style type="text/css">
    :root {
      --header-links: <%= @user_color[:header_links].blank? || @user_color[:header_links].nil? ? '#ffffff'  : @user_color[:header_links][:rgba] %>;
      --normal-links: <%= @user_color[:normal_links].blank? || @user_color[:normal_links].nil? ? '#888'  : @user_color[:normal_links][:rgba] %>;
      --footer-links: <%= @user_color[:footer_links].blank? || @user_color[:footer_links].nil? ? '#4c86e5'  : @user_color[:footer_links][:rgba] %>;
      --title-color: <%= @user_color[:title_color].blank? || @user_color[:title_color].nil? ? '#000000'  : @user_color[:title_color][:rgba] %>;
      --normal-text-color: <%= @user_color[:normal_text_color].blank? || @user_color[:normal_text_color].nil? ? '#000000'  : @user_color[:normal_text_color][:rgba] %>;
      --header-background: <%= @user_color[:header_background].blank? || @user_color[:header_background].nil? ? '#606060'  : @user_color[:header_background][:rgba] %>;
      --body-background: <%= @user_color[:body_background].blank? || @user_color[:body_background].nil? ? '#ffffff'  : @user_color[:body_background][:rgba] %>;
      --footer-background: <%= @user_color[:footer_background].blank? || @user_color[:footer_background].nil? ? '#181818'  : @user_color[:footer_background][:rgba] %>;
      --bullet-icon-color: <%= @user_color[:bullet_icon_color].blank? || @user_color[:bullet_icon_color].nil? ? ''  : @user_color[:bullet_icon_color][:rgba] %>;
      --image-overlay-color: <%= @user_color[:image_overlay_font_color].blank? || @user_color[:image_overlay_font_color].nil? ? '#ffffff'  : @user_color[:image_overlay_font_color][:rgba] %>;
      --header_title_color: <%= @user_color[:header_title_color].blank? || @user_color[:header_title_color].nil? ? '#ffffff'  : @user_color[:header_title_color][:rgba] %>;
      --active-header-link-color: <%= @user_color[:active_header_link].blank? || @user_color[:active_header_link].nil? ? '#4c86e5'  : @user_color[:active_header_link][:rgba] %>;
      --hover-header-link-color: <%= @user_color[:hover_header_link].blank? || @user_color[:hover_header_link].nil? ? '#ffffff'  : @user_color[:hover_header_link][:rgba] %>;
      --active-normal-link-color: <%= @user_color[:active_normal_link].blank? || @user_color[:active_normal_link].nil? ? '#4c86e5'  : @user_color[:active_normal_link][:rgba] %>;
      --hover-normal-link-color: <%= @user_color[:hover_normal_link].blank? || @user_color[:hover_normal_link].nil? ? '#888'  : @user_color[:hover_normal_link][:rgba] %>;
      --button-background-color: <%= @user_color[:button_background_color].blank? || @user_color[:button_background_color].nil? ? '#4c86e5'  : @user_color[:button_background_color][:rgba] %>;
      --button-font-color: <%= @user_color[:button_font_color].blank? || @user_color[:button_font_color].nil? ? '#ffffff'  : @user_color[:button_font_color][:rgba] %>;
      --button-hover-background-color: <%= @user_color[:button_hover_background_color].blank? || @user_color[:button_hover_background_color].nil? ? '#3b78db'  : @user_color[:button_hover_background_color][:rgba] %>;
      --button-hover-font-color: <%= @user_color[:button_hover_font_color].blank? || @user_color[:button_hover_font_color].nil? ? '#ffffff'  : @user_color[:button_hover_font_color][:rgba] %>;
      --footer-text-color: <%= @user_color[:footer_text_color].blank? || @user_color[:footer_text_color].nil? ? '#ffffff'  : @user_color[:footer_text_color][:rgba] %>;;
    }

    .header-links {
      color: var(--header-links) !important;
    }
    .normal-links {
      color: var(--normal-links) !important;
    }
    .footer-links {
      color: var(--footer-links) !important;
    }
    .title-text-color {
      color: var(--title-color) !important;
    }
    .normal-text-color {
      color: var(--normal-text-color) !important;
    }
    span.about_us_detail_warp span{
      color: var(--normal-text-color) !important;
    }
    .header-background {
      background: var(--header-background) !important;
    }
    .body-background {
      color: var(--body-background) !important;
    }
    .footer-background {
      background: var(--footer-background) !important;
    }    
    .bullet-icon-color {
      color: var(--bullet-icon-color) !important;
    }
    .navbar-nav .nav-link{
      color: var(--header-links) !important;
    }
    .navbar-nav .nav-item .active{
      color: var(--active-header-link-color) !important;
    }.navbar-nav .nav-item .nav-link:hover{
      color: var(--hover-header-link-color) !important;
    }
    /*.cbp-filter-item.cbp-filter-item-active, .cbp-filter-item:hover, .cbp-filter-item-active a {
      color: #4c86e5 !important;
    }*/
    .cbp-filter-item.cbp-filter-item-active a, .back_link{
      color: var(--active-normal-link-color) !important;
    }
    .cbp-filter-item a:hover{
      color: var(--hover-normal-link-color) !important;
    }
    .inverse-text .icon-color:not(.color-default),
    .inverse-text li,
    .inverse-text p,
    .inverse-text h2:not([class*="color-"]),
    .inverse-text h3:not([class*="color-"]),
    .inverse-text h4:not([class*="color-"]),
    .inverse-text h5:not([class*="color-"]),
    .inverse-text h6:not([class*="color-"]),
    .inverse-text .blockquote-footer,
    .inverse-text .accordion-wrapper.bordered .card-header a,
    .inverse-text .accordion-wrapper .card-header a.collapsed,
    .inverse-text .color-dark,
    .inverse-text label,
    .inverse-text .glyphs.css-mapping i:before,
    .inverse-text .list-group-item-action,
    .inverse-text .pagination ul>li:not(.active)>a,
    .inverse-text .page-navi:not(.bg) a,
    .inverse-text .nav-tabs .nav-link:not(.active),
    .inverse-text .cbp-filter-item:not(.cbp-filter-item-active) {
      color: var(--title-color) !important;
    }
    /*.inverse-text {
      color: var(--normal-text-color) !important;
    }*/
    .overlay4:not(.caption-dark) * {
      color: var(--image-overlay-color) !important;
    }
    .social-l i{
      color: var(--bullet-icon-color) !important;
    }
    body, .light-wrapper{
      background-color: var(--body-background) !important;
    }
    .inverse-text h1:not([class*="color-"]){
      color: var(--header_title_color) !important;
    }
    .button-background{
      background: var(--button-background-color) !important;
    }
    .button-font-color{
      color: var(--button-font-color) !important;
    }
    .button-background-hover:hover{
      background: var(--button-hover-background-color) !important;
    }
    .button-font-hover:hover{
      color: var(--button-hover-font-color) !important;
    }
    .footer-text-color{
      color: var(--footer-text-color) !important;
    }
    .flickr_pagination .current{
      color: var(--active-normal-link-color) !important;
    }
    .flickr_pagination a {
      color: var(--normal-links) !important;
    }
    .flickr_pagination a:hover{
      background: var(--hover-normal-link-color) !important;
    }
    .testimonials-section {
      background: #f9fafb;
      padding: 3rem 1rem;
    }

    .testimonials-section h2 {
      font-size: 2rem;
      font-weight: 700;
      text-align: center;
      margin-bottom: 2rem;
      color: #111827;
    }

    .testimonials-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .testimonial-card {
       background: #fff;
      border-radius: 16px;
      padding: 2rem;
      box-shadow: 0 6px 18px rgba(0,0,0,0.1);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .testimonial-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }

    .testimonial-card img {
      border-radius: 50%;
      width: 80px;
      height: 80px;
      object-fit: cover;
      border: 3px solid #fbbf24; /* gold border around photo */
      margin-bottom: 1rem;
    }

    .testimonial-quote {
      font-style: italic;
      color: #444;
      position: relative;
      margin-bottom: 1rem;
      line-height: 1.6;
    }

    .testimonial-quote::before {
      content: "“";
      font-size: 2rem;
      color: #fbbf24;
      position: absolute;
      left: -15px;
      top: -10px;
    }

    .testimonial-quote::after {
      content: "”";
      font-size: 2rem;
      color: #fbbf24;
      position: absolute;
      right: -15px;
      bottom: -10px;
    }


    .testimonial-photo {
      width: 100%;
      height: 220px;
      object-fit: cover;
    }

    .testimonial-body {
      padding: 1rem 1.25rem;
    }

    .testimonial-content {
      font-size: 0.95rem;
      font-style: italic;
      color: #374151;
      margin-bottom: 1rem;
    }

    .testimonial-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 1rem;
    }

    .testimonial-name {
      font-weight: bold;
      font-size: 1.1rem;
      color: #222;
      display: inline-block;   /* ensure it doesn’t force stars below */
      margin: 0;
    }

    .stars {
      display: flex;
      gap: 3px;
    }

    .star {
      width: 20px;
      height: 20px;
    }

    .star.filled {
      color: #fbbf24; /* yellow */
    }

    .star.empty {
      color: #d1d5db; /* light gray */
    }

    /* Responsive grid */
    @media (min-width: 768px) {
      .testimonials-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 1024px) {
      .testimonials-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }
  </style>
<% end %>
